{
    "cmake.ignoreCMakeListsMissing": true,
    "java.import.gradle.enabled": false,
    "java.autobuild.enabled": false,
    "files.watcherExclude": {
        "**/build/**": true,
        "**/.dart_tool/**": true,
        "**/node_modules/**": true,
        "**/.gradle/**": true,
        "**/.codex_tmp/**": true,
        "content-factory/out/**": true
    },
    "search.exclude": {
        "**/build": true,
        "**/.dart_tool": true,
        "**/.codex_tmp": true
    }
}
